# --- RECOMMENDED FOR STABILITY (Prevents OOM Crashes) ---
# Use Qdrant Cloud to offload vector storage RAM usage
QDRANT_URL=https://your-cluster-url.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# --- CORE CONFIG ---
OPENAI_API_KEY=your_key_here
CHROMA_PERSIST_DIR=./vectorstore/db
NEWS_REFRESH_INTERVAL_HOURS=6
# Default broadcast topic — everyone subscribes here for official alerts
NTFY_DEFAULT_TOPIC=Andes_Virus_Research_Aditya_Aravind_Medepalli
# Leave blank for open access (local dev). Set to restrict public deployment.
APP_PASSWORD=

# SMTP for email alerts (optional — ntfy.sh works without these)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
BUILD_TRIGGER=1
